{
  "name": "yassine-tbib-portfolio",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/prepare-content.mjs && node scripts/generate-site.mjs --local && vite",
    "build": "node scripts/prepare-content.mjs && node scripts/generate-site.mjs && tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "node scripts/prepare-content.mjs && node scripts/generate-site.mjs && tsc -b --pretty false",
    "prepare:content": "node scripts/prepare-content.mjs",
    "migrate:content": "node scripts/prepare-content.mjs --migrate",
    "prepare:admin": "node scripts/generate-site.mjs",
    "cms": "decap-server",
    "cms:local": "node scripts/generate-site.mjs --local && decap-server"
  },
  "engines": {
    "node": "20.x"
  },
  "dependencies": {
    "@fontsource/anton": "^5.1.1",
    "@fontsource/manrope": "^5.1.1",
    "@fontsource/mrs-saint-delafield": "^5.1.1",
    "@react-three/drei": "^9.117.3",
    "@react-three/fiber": "^8.17.10",
    "@vercel/analytics": "^1.6.1",
    "gsap": "^3.12.5",
    "lenis": "^1.1.18",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.28.1",
    "three": "^0.169.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "decap-server": "^3.11.6",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
