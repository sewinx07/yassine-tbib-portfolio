# Copy to .env.local for local checks. Never commit real values.

# Public origin used for OAuth callback URLs, generated config.yml and sitemap.
SITE_URL=https://portfolio-yassine.vercel.app
# GitHub repository that holds the CMS content: owner/repo.
GITHUB_REPO=YOUR_GITHUB_USERNAME/your-repo

# Decap CMS GitHub OAuth App credentials (server-side only).
# Authorization callback URL: https://portfolio-yassine.vercel.app/api/callback
OAUTH_GITHUB_CLIENT_ID=replace-with-github-client-id
OAUTH_GITHUB_CLIENT_SECRET=replace-with-github-client-secret
# Optional: override requested GitHub scopes (default: repo,user).
OAUTH_GITHUB_SCOPE=repo,user
# Optional: extra origins allowed to call /api/auth and /api/contact (comma separated).
ALLOWED_ADMIN_ORIGINS=https://preview-url.vercel.app

# Contact form delivery via Resend. Messages are emailed, never stored.
RESEND_API_KEY=re_replace_with_resend_key
CONTACT_TO_EMAIL=tbibyassine03@gmail.com
CONTACT_FROM_EMAIL=Yassine Portfolio <contact@your-verified-domain.com>

# Optional Upstash Redis REST rate limiting. Without it, rate limiting is disabled.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
